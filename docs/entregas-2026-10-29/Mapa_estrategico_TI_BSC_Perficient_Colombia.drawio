<mxfile host="app.diagrams.net"><diagram id="mapa-bsc-ti" name="Mapa estratégico de TI"><mxGraphModel dx="2000" dy="1520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m1" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2000" height="1520" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Mapa estratégico de TI (BSC de TI)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Perficient, operación en Colombia · PETI 2026-2028 · octubre de 2026 a septiembre de 2028&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1300" height="64" as="geometry"/></mxCell><mxCell id="m3" value="Equipo Firmes por la Gobernanza&lt;br&gt;Gobierno y Servicios de TI · Universidad Santiago de Cali&lt;br&gt;29 de octubre de 2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=11;align=right;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1440" y="18" width="520" height="64" as="geometry"/></mxCell><mxCell id="m4" value="1" style="rounded=0;html=1;fillColor=#F2C94C;strokeColor=none;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="6" y="95" width="28" height="28" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;Misión de TI&lt;/b&gt; (PETI §7, propuesta)&lt;br&gt;Proveer y gobernar las plataformas, herramientas y controles con los que la operación colombiana entrega software y soluciones de IA a sus clientes, de forma segura, medible y conforme con la ley." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="640" height="125" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b&gt;Visión de TI&lt;/b&gt; (PETI §7, propuesta)&lt;br&gt;En septiembre de 2028, la operación de Perficient en Colombia gestionará el uso de la IA con un sistema certificable, entregará software con pipelines y ambientes estandarizados y medirá su desempeño cada trimestre." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="695" y="95" width="640" height="125" as="geometry"/></mxCell><mxCell id="m7" value="&lt;b&gt;Valores de TI&lt;/b&gt; (propuestos por el equipo; el PETI no los define)&lt;br&gt;• Seguridad desde el diseño: los controles se definen antes de entregar.&lt;br&gt;• Decidir con datos: cada objetivo tiene indicador, meta y responsable.&lt;br&gt;• Cumplimiento demostrable: lo que se promete al cliente se puede auditar.&lt;br&gt;• Aprendizaje continuo: certificación y rotación del talento." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="95" width="610" height="125" as="geometry"/></mxCell><mxCell id="m8" value="3" style="rounded=0;html=1;fillColor=#F2C94C;strokeColor=none;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="6" y="236" width="28" height="28" as="geometry"/></mxCell><mxCell id="m9" value="&lt;b&gt;Prioridades estratégicas&lt;/b&gt;&lt;br&gt;Objetivos de TI del PETI (§7); color de cada objetivo del mapa" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="285" height="50" as="geometry"/></mxCell><mxCell id="m10" value="&lt;b&gt;OETI01&lt;/b&gt; Gobernar el uso de la IA en la operación colombiana" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=11;fontColor=#333333;spacing=6;" vertex="1" parent="1"><mxGeometry x="335" y="232" width="262" height="50" as="geometry"/></mxCell><mxCell id="m11" value="&lt;b&gt;OETI02&lt;/b&gt; Mantener la certificación de seguridad y cumplir la Ley 1581" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#333333;spacing=6;" vertex="1" parent="1"><mxGeometry x="637" y="232" width="262" height="50" as="geometry"/></mxCell><mxCell id="m12" value="&lt;b&gt;OETI03&lt;/b&gt; Estandarizar la entrega de software, su gobierno y su costo" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontColor=#333333;spacing=6;" vertex="1" parent="1"><mxGeometry x="939" y="232" width="262" height="50" as="geometry"/></mxCell><mxCell id="m13" value="&lt;b&gt;OETI04&lt;/b&gt; Desarrollar las capacidades del talento en IA, nube y datos" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontColor=#333333;spacing=6;" vertex="1" parent="1"><mxGeometry x="1241" y="232" width="262" height="50" as="geometry"/></mxCell><mxCell id="m14" value="2" style="rounded=0;html=1;fillColor=#F2C94C;strokeColor=none;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="6" y="290" width="28" height="28" as="geometry"/></mxCell><mxCell id="m15" value="&lt;b&gt;Paso 2.&lt;/b&gt; Perspectivas del BSC de TI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="290" height="24" as="geometry"/></mxCell><mxCell id="m16" value="4" style="rounded=0;html=1;fillColor=#F2C94C;strokeColor=none;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="335" y="290" width="28" height="28" as="geometry"/></mxCell><mxCell id="m17" value="&lt;b&gt;Paso 4.&lt;/b&gt; Objetivos estratégicos  ·  &lt;b&gt;Paso 6.&lt;/b&gt; Métricas y metas  ·  &lt;b&gt;Paso 7.&lt;/b&gt; Iniciativas (proyectos del PETI)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="369" y="292" width="900" height="24" as="geometry"/></mxCell><mxCell id="m18" value="5" style="rounded=0;html=1;fillColor=#F2C94C;strokeColor=none;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1540" y="290" width="28" height="28" as="geometry"/></mxCell><mxCell id="m19" value="&lt;b&gt;Paso 5.&lt;/b&gt; Razonamiento causa-efecto" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1574" y="292" width="380" height="24" as="geometry"/></mxCell><mxCell id="m20" value="" style="rounded=0;fillColor=#FBFBFB;strokeColor=#DDDDDD;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1480" height="244" as="geometry"/></mxCell><mxCell id="m21" value="&lt;b&gt;Contribución al negocio&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;horizontal=0;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="46" height="244" as="geometry"/></mxCell><mxCell id="m22" value="&lt;i&gt;¿Cómo ve la dirección al área de TI?&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;Equivale a la perspectiva financiera del BSC de Kaplan y Norton.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="94" y="342" width="230" height="214" as="geometry"/></mxCell><mxCell id="m23" value="" style="rounded=0;fillColor=#F3F3F3;strokeColor=#DDDDDD;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1480" height="244" as="geometry"/></mxCell><mxCell id="m24" value="&lt;b&gt;Perspectiva del usuario&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;horizontal=0;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="46" height="244" as="geometry"/></mxCell><mxCell id="m25" value="&lt;i&gt;¿Cómo ven los usuarios al área de TI?&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;Equivale a la perspectiva del cliente del BSC de Kaplan y Norton.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="94" y="592" width="230" height="214" as="geometry"/></mxCell><mxCell id="m26" value="" style="rounded=0;fillColor=#FBFBFB;strokeColor=#DDDDDD;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1480" height="244" as="geometry"/></mxCell><mxCell id="m27" value="&lt;b&gt;Perspectiva interna&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;horizontal=0;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="46" height="244" as="geometry"/></mxCell><mxCell id="m28" value="&lt;i&gt;¿Cuán efectivos y eficientes son los procesos del área de TI?&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;Equivale a la perspectiva de procesos internos del BSC de Kaplan y Norton.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="94" y="842" width="230" height="214" as="geometry"/></mxCell><mxCell id="m29" value="" style="rounded=0;fillColor=#F3F3F3;strokeColor=#DDDDDD;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="1480" height="244" as="geometry"/></mxCell><mxCell id="m30" value="&lt;b&gt;Perspectiva de innovación&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;horizontal=0;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="46" height="244" as="geometry"/></mxCell><mxCell id="m31" value="&lt;i&gt;¿Cómo está posicionada el área de TI con respecto a las necesidades futuras del negocio?&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;Equivale a la perspectiva de aprendizaje y crecimiento del BSC de Kaplan y Norton.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="94" y="1092" width="230" height="214" as="geometry"/></mxCell><mxCell id="m32" value="" style="rounded=0;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="335" y="342" width="262" height="214" as="geometry"/></mxCell><mxCell id="m33" value="&lt;b&gt;CN1 · Conservar la confianza de los clientes regulados&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=none;fontSize=11;fontColor=#222222;spacing=4;" vertex="1" parent="m32"><mxGeometry x="0" y="0" width="262" height="46" as="geometry"/></mxCell><mxCell id="m34" value="Apoya OC02 · OETI02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=9;fontColor=#666666;verticalAlign=middle;" vertex="1" parent="m32"><mxGeometry x="6" y="47" width="250" height="18" as="geometry"/></mxCell><mxCell id="m35" value="R" style="rounded=0;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="m32"><mxGeometry x="6" y="80" width="22" height="22" as="geometry"/></mxCell><mxCell id="m36" value="&lt;b&gt;KPI-07&lt;/b&gt; No conformidades mayores ISO/IEC 27001&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Año 1: 0 · Año 2: 0&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;fontColor=#222222;" vertex="1" parent="m32"><mxGeometry x="32" y="68" width="224" height="46" as="geometry"/></mxCell><mxCell id="m37" value="R" style="rounded=0;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="m32"><mxGeometry x="6" y="130" width="22" height="22" as="geometry"/></mxCell><mxCell id="m38" value="&lt;b&gt;KPI-13&lt;/b&gt; Informe SOC 2 tipo II sin salvedades&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Año 2: sí&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;fontColor=#222222;" vertex="1" parent="m32"><mxGeometry x="32" y="118" width="224" height="46" as="geometry"/></mxCell><mxCell id="m39" value="&lt;b&gt;Iniciativas:&lt;/b&gt; P1.1 · P4.1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=6;fillColor=#F1F1F1;strokeColor=none;fontSize=10;fontColor=#222222;" vertex="1" parent="m32"><mxGeometry x="0" y="178" width="262" height="36" as="geometry"/></mxCell><mxCell id="m40" value="" style="rounded=0;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="637" y="342" width="262" height="214" as="geometry"/></mxCell><mxCell id="m41" value="&lt;b&gt;CN2 · Llevar la IA a producción con los clientes&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=none;fontSize=11;fontColor=#222222;spacing=4;" vertex="1" parent="m40"><mxGeometry x="0" y="0" width="262" height="46" as="geometry"/></mxCell><mxCell id="m42" value="Apoya OC01 · OETI01" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=9;fontColor=#666666;verticalAlign=middle;" vertex="1" parent="m40"><mxGeometry x="6" y="47" width="250" height="18" as="geometry"/></mxCell><mxCell id="m43" value="R" style="rounded=0;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="m40"><mxGeometry x="6" y="80" width="22" height="22" as="geometry"/></mxCell><mxCell id="m44" value="&lt;b&gt;KPI-03&lt;/b&gt; Casos de IA en producción con clientes&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Año 1: 1 · Año 2: 5&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;fontColor=#222222;" vertex="1" parent="m40"><mxGeometry x="32" y="68" width="224" height="46" as="geometry"/></mxCell><mxCell id="m45" value="&lt;b&gt;Iniciativas:&lt;/b&gt; P3.1 · P3.3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=6;fillColor=#F1F1F1;strokeColor=none;fontSize=10;fontColor=#222222;" vertex="1" parent="m40"><mxGeometry x="0" y="178" width="262" height="36" as="geometry"/></mxCell><mxCell id="m46" value="" style="rounded=0;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="939" y="342" width="262" height="214" as="geometry"/></mxCell><mxCell id="m47" value="&lt;b&gt;CN3 · Operar con un costo de TI controlado y trazable&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFE6CC;strokeColor=none;fontSize=11;fontColor=#222222;spacing=4;" vertex="1" parent="m46"><mxGeometry x="0" y="0" width="262" height="46" as="geometry"/></mxCell><mxCell id="m48" value="Apoya OC03 · OETI03" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=9;fontColor=#666666;verticalAlign=middle;" vertex="1" parent="m46"><mxGeometry x="6" y="47" width="250" height="18" as="geometry"/></mxCell><mxCell id="m49" value="R" style="rounded=0;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="m46"><mxGeometry x="6" y="80" width="22" height="22" as="geometry"/></mxCell><mxCell i