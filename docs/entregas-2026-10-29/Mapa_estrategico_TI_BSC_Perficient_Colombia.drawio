tml=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=9;fontColor=#666666;verticalAlign=middle;" vertex="1" parent="m114"><mxGeometry x="6" y="47" width="250" height="18" as="geometry"/></mxCell><mxCell id="m117" value="A" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;fontStyle=1;fontSize=11;" vertex="1" parent="m114"><mxGeometry x="6" y="80" width="22" height="22" as="geometry"/></mxCell><mxCell id="m118" value="&lt;b&gt;KPI-10&lt;/b&gt; Personal rotado entre células&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Año 1: 50 % · Año 2: 100 %&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=4;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;fontColor=#222222;" vertex="1" parent="m114"><mxGeometry x="32" y="68" width="224" height="46" as="geometry"/></mxCell><mxCell id="m119" value="&lt;b&gt;Iniciativas:&lt;/b&gt; Sin proyecto propio en el PETI" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=6;fillColor=#F1F1F1;strokeColor=none;fontSize=10;fontColor=#222222;" vertex="1" parent="m114"><mxGeometry x="0" y="178" width="262" height="36" as="geometry"/></mxCell><mxCell id="m120" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m108" target="m84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m121" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m108" target="m90"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="859.7" y="1078"/><mxPoint x="991.4" y="1078"/></Array></mxGeometry></mxCell><mxCell id="m122" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m114" target="m90"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m123" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="m102" target="m66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="627" y="1145.5"/><mxPoint x="627" y="773.9"/></Array></mxGeometry></mxCell><mxCell id="m124" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m84" target="m66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m125" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0;exitY=0.12;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="m84" target="m32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="617" y="867.68"/><mxPoint x="617" y="470.4"/></Array></mxGeometry></mxCell><mxCell id="m126" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="m78" target="m32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="607" y="895.5"/><mxPoint x="607" y="523.9"/></Array></mxGeometry></mxCell><mxCell id="m127" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m90" target="m72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m128" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="m90" target="m46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1221" y="895.5"/><mxPoint x="1221" y="523.9"/></Array></mxGeometry></mxCell><mxCell id="m129" value="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m96" target="m54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m130" value="11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m66" target="m40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m131" value="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m72" target="m46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m132" value="13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.6;fontSize=10;fontStyle=1;fontColor=#222222;labelBackgroundColor=#FFF2B3;labelBorderColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m60" target="m32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m133" value="Se lee de abajo hacia arriba: el talento (innovación) mejora los procesos de TI (interna); los procesos dan a usuarios y clientes lo que necesitan (usuario), y eso sostiene lo que la dirección espera de TI (contribución al negocio).&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; IF1 → PI1: El personal certificado en IA y seguridad aplica los controles del sistema de gestión de IA.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; IF1 → PI3: El personal certificado en nube automatiza los ambientes con infraestructura como código.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; IF2 → PI3: La rotación lleva las mismas plantillas y prácticas a todas las células.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; IF3 → US1: El centro de excelencia prueba las herramientas de IA antes de que lleguen a las células.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; PI1 → US1: Con inventario y reglas claras, las licencias de IA se aprueban sin frenar a las células.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; PI1 → CN1: El sistema de gestión de IA aporta los controles de IA que incluirá el informe SOC 2 (P4.1).&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; PI2 → CN1: Cerrar a tiempo las vulnerabilidades críticas evita no conformidades en la auditoría ISO/IEC 27001.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; PI3 → US2: Las plantillas ALM homologadas permiten conciliar horas y tareas (P2.1 precede a P2.4).&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; PI3 → CN3: Con infraestructura como código y observabilidad, el costo de nube se mide por ambiente y se puede recortar.&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; PI4 → CN4: Los comités con acta revisan el portafolio cada mes y corrigen los desvíos a tiempo.&lt;br&gt;&lt;b&gt;11.&lt;/b&gt; US1 → CN2: Las células que ya usan IA con licencia generan los casos que llegan a producción.&lt;br&gt;&lt;b&gt;12.&lt;/b&gt; US2 → CN3: Las horas conciliadas con tareas muestran en qué se va el costo de la operación.&lt;br&gt;&lt;b&gt;13.&lt;/b&gt; US3 → CN1: Medir la satisfacción avisa antes de que un cliente pierda la confianza (hipótesis del equipo).&lt;br&gt;&lt;br&gt;&lt;b&gt;Vacíos que muestra el mapa&lt;/b&gt; (para la versión 1.1 del PETI)&lt;br&gt;• La contribución al negocio tiene un solo indicador de costo (KPI-02); falta el costo de TI por hora facturada.&lt;br&gt;• US3 e IF2 no tienen proyecto; CN3, US3 e IF3 dependen de métricas que el PETI todavía no define.&lt;br&gt;• Los indicadores siguen a los objetivos de TI, no a los procesos: faltan objetivos e indicadores por proceso (diagnóstico BSC, enunciados 22 a 24)." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFDF2;strokeColor=#E0C060;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1540" y="320" width="420" height="994" as="geometry"/></mxCell><mxCell id="m134" value="8" style="rounded=0;html=1;fillColor=#F2C94C;strokeColor=none;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="6" y="1338" width="28" height="28" as="geometry"/></mxCell><mxCell id="m135" value="&lt;b&gt;Paso 8.&lt;/b&gt; Cascada: el mapa baja a cada nivel con sus propios objetivos e indicadores (propuesto, P2.8)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="900" height="24" as="geometry"/></mxCell><mxCell id="m136" value="&lt;b&gt;Corporativo&lt;/b&gt;&lt;br&gt;Objetivos OC01 a OC04 (PETI §5.2)" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#E8EEF6;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1374" width="250" height="66" as="geometry"/></mxCell><mxCell id="m137" value="&lt;b&gt;TI Colombia&lt;/b&gt;&lt;br&gt;Este mapa · Comité Directivo del PETI, trimestral" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#E8EEF6;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1374" width="250" height="66" as="geometry"/></mxCell><mxCell id="m138" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.6;" edge="1" parent="1" source="m136" target="m137"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m139" value="&lt;b&gt;Táctico&lt;/b&gt;&lt;br&gt;Comité Táctico de TI, mensual: proyectos, KPI y riesgos" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#E8EEF6;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="1374" width="250" height="66" as="geometry"/></mxCell><mxCell id="m140" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.6;" edge="1" parent="1" source="m137" target="m139"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m141" value="&lt;b&gt;Célula&lt;/b&gt;&lt;br&gt;Comité por célula, semanal: KPI-04, KPI-05 y KPI-06 de la célula" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#E8EEF6;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="1374" width="250" height="66" as="geometry"/></mxCell><mxCell id="m142" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.6;" edge="1" parent="1" source="m139" target="m141"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m143" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;" vertex="1" parent="1"><mxGeometry x="1220" y="1338" width="740" height="112" as="geometry"/></mxCell><mxCell id="m144" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1230" y="1342" width="200" height="20" as="geometry"/></mxCell><mxCell id="m145" value="R" style="rounded=0;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1232" y="1368" width="20" height="20" as="geometry"/></mxCell><mxCell id="m146" value="Métrica de resultado: muestra si el objetivo se logró" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1258" y="1368" width="320" height="20" as="geometry"/></mxCell><mxCell id="m147" value="A" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1232" y="1394" width="20" height="20" as="geometry"/></mxCell><mxCell id="m148" value="Métrica de actuación: se mueve antes y anticipa el resultado" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1258" y="1394" width="320" height="20" as="geometry"/></mxCell><mxCell id="m149" value="" style="rounded=0;dashed=1;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1232" y="1420" width="70" height="20" as="geometry"/></mxCell><mxCell id="m150" value="Métrica propuesta por el equipo, sin KPI en el PETI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1308" y="1420" width="270" height="20" as="geometry"/></mxCell><mxCell id="m151" value="1" style="rounded=0;html=1;fillColor=#FFF2B3;strokeColor=#444444;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1600" y="1368" width="20" height="20" as="geometry"/></mxCell><mxCell id="m152" value="Relación causa-efecto; el número remite al Paso 5" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1626" y="1368" width="320" height="20" as="geometry"/></mxCell><mxCell id="m153" value="" style="rounded=0;fillColor=#F1F1F1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1600" y="1394" width="70" height="20" as="geometry"/></mxCell><mxCell id="m154" value="Iniciativas: proyectos del portafolio (PETI §9)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1676" y="1394" width="280" height="20" as="geometry"/></mxCell><mxCell id="m155" value="Metas: año 1 = septiembre de 2027; año 2 = septiembre de 2028" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="1420" width="350" height="20" as="geometry"/></mxCell><mxCell id="m156" value="Fuente: PETI Colombia v1.0 (§5.2, §7, §9 y §10) y diagnóstico BSC del 22 de octubre de 2026. Todo el mapa es una propuesta del equipo (INT-001) y depende de la aprobación del Comité Directivo del PETI. Perspectivas del BSC de TI según Van Grembergen y Van Bruggen (1997); pasos según BSC Designer, &quot;8 pasos para crear un mapa estratégico&quot;. Trabajo académico; no es un documento oficial de Perficient." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="1920" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>