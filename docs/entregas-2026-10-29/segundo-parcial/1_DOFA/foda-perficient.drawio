  <diagram id="dofa-final" name="DOFA final">
    <mxGraphModel dx="1552" dy="1051" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;fontSize=24;fontStyle=1;fontColor=#1F1F1F;" value="Análisis DOFA — Perficient, operación en Colombia (PETI 2026-2028)" vertex="1">
          <mxGeometry height="44" width="1400" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#4D4D4D;strokeColor=#4D4D4D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" value="FAVORABLE" vertex="1">
          <mxGeometry height="34" width="670" x="110" y="74" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#4D4D4D;strokeColor=#4D4D4D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" value="DESFAVORABLE" vertex="1">
          <mxGeometry height="34" width="670" x="780" y="74" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#4D4D4D;strokeColor=#4D4D4D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;horizontal=0;" value="ANÁLISIS INTERNO" vertex="1">
          <mxGeometry height="460" width="50" x="50" y="118" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#4D4D4D;strokeColor=#4D4D4D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;horizontal=0;" value="ANÁLISIS EXTERNO" vertex="1">
          <mxGeometry height="390" width="50" x="50" y="588" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#82B366;strokeColor=#5A8A43;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" value="Fortalezas" vertex="1">
          <mxGeometry height="40" width="670" x="110" y="118" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EEF6EA;strokeColor=#5A8A43;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;" value="&lt;b&gt;F1&lt;/b&gt; [Seguridad] SGSI certificado en ISO/IEC 27001:2022, certificado ISMS-PE-101123 de A-Lign (PUB-002)&lt;br&gt;&lt;br&gt;&lt;b&gt;F2&lt;/b&gt; [Estrategia] Posicionamiento declarado &quot;AI-native&quot; (PUB-003) y alianzas de IA con Lovable y Gradial (PUB-009, PUB-010)&lt;br&gt;&lt;br&gt;&lt;b&gt;F3&lt;/b&gt; [Información, uso y apropiación] Alianzas con Microsoft, Databricks y Snowflake (PUB-005 a PUB-008)&lt;br&gt;&lt;br&gt;&lt;b&gt;F4&lt;/b&gt; [Seguridad, sistemas] Pruebas de seguridad continuas y análisis de dependencias en la cuenta analizada (PRV-001)&lt;br&gt;&lt;br&gt;&lt;b&gt;F5&lt;/b&gt; [Gobierno, infraestructura] Roles definidos, Scrum y ambientes separados en la cuenta analizada (PRV-001)&lt;br&gt;&lt;br&gt;&lt;b&gt;F6&lt;/b&gt; [Uso y apropiación] Formación en línea, patrocinio de certificaciones y capacitaciones obligatorias en la cuenta analizada (PRV-001)" vertex="1">
          <mxGeometry height="420" width="670" x="110" y="158" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#B85450;strokeColor=#8F3B38;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" value="Debilidades" vertex="1">
          <mxGeometry height="40" width="670" x="780" y="118" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBECEB;strokeColor=#8F3B38;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;" value="&lt;b&gt;D1&lt;/b&gt; [Seguridad, información] Uso de IA sin sistema de gestión, sin inventario y sin permisos para agentes (INT-001; PRV-001)&lt;br&gt;&lt;br&gt;&lt;b&gt;D2&lt;/b&gt; [Gobierno] Sin comité de TI, RACI, matriz de riesgos ni presupuesto de TI (INT-001)&lt;br&gt;&lt;br&gt;&lt;b&gt;D3&lt;/b&gt; [Seguridad, gobierno] Transferencias internacionales de datos sin registro por proyecto; obligaciones posteriores a la privatización sin concepto legal (INT-001; PUB-004)&lt;br&gt;&lt;br&gt;&lt;b&gt;D4&lt;/b&gt; [Estrategia] Sin misión, visión, catálogo de servicios ni tablero de TI (INT-001)&lt;br&gt;&lt;br&gt;&lt;b&gt;D5&lt;/b&gt; [Sistemas de información] Hallazgos de seguridad y horas se pasan a mano entre herramientas (PRV-001)&lt;br&gt;&lt;br&gt;&lt;b&gt;D6&lt;/b&gt; [Infraestructura] Sin infraestructura como código ni control de costos de nube (INT-001)&lt;br&gt;&lt;br&gt;&lt;b&gt;D7&lt;/b&gt; [Uso y apropiación] Adopción de IA no medida y canal de licencias no estandarizado (PRV-001; INT-001)" vertex="1">
          <mxGeometry height="420" width="670" x="780" y="158" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#6C8EBF;strokeColor=#46699B;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" value="Oportunidades" vertex="1">
          <mxGeometry height="40" width="670" x="110" y="588" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EAF0F9;strokeColor=#46699B;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;" value="&lt;b&gt;O1&lt;/b&gt; Clientes que piden IA gobernada y auditable&lt;br&gt;&lt;br&gt;&lt;b&gt;O2&lt;/b&gt; ISO/IEC 42001 y NIST AI RMF para ordenar y demostrar el gobierno de la IA&lt;br&gt;&lt;br&gt;&lt;b&gt;O3&lt;/b&gt; Informe SOC 2 tipo II con controles de IA como requisito de clientes regulados&lt;br&gt;&lt;br&gt;&lt;b&gt;O4&lt;/b&gt; Plataformas, formación y certificaciones de los socios&lt;br&gt;&lt;br&gt;&lt;b&gt;O5&lt;/b&gt; Prácticas maduras de DevSecOps, infraestructura como código y observabilidad&lt;br&gt;&lt;br&gt;&lt;b&gt;O6&lt;/b&gt; COBIT 2019 como referencia para el gobierno y el presupuesto de TI" vertex="1">
          <mxGeometry height="350" width="670" x="110" y="628" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#D79B00;strokeColor=#A87900;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" value="Amenazas" vertex="1">
          <mxGeometry height="40" width="670" x="780" y="588" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF4E0;strokeColor=#A87900;fontColor=#1F1F1F;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;" value="&lt;b&gt;A1&lt;/b&gt; El certificado ISO vence el 11 de octubre de 2026 y no hay evidencia pública de su recertificación (PUB-002, PUB-018; R02)&lt;br&gt;&lt;br&gt;&lt;b&gt;A2&lt;/b&gt; Fuga de código o datos e inyección de instrucciones por herramientas de IA (R01, R05)&lt;br&gt;&lt;br&gt;&lt;b&gt;A3&lt;/b&gt; Sanción por incumplir la Ley 1581 y leyes de datos más exigentes en la región (PUB-013, PUB-014; R04)&lt;br&gt;&lt;br&gt;&lt;b&gt;A4&lt;/b&gt; Competidores nearshore que ya certificaron su gobierno de IA: Softtek, ISO/IEC 42001 desde noviembre de 2025 (PUB-017)&lt;br&gt;&lt;br&gt;&lt;b&gt;A5&lt;/b&gt; Vulnerabilidades heredadas de dependencias (R03)&lt;br&gt;&lt;br&gt;&lt;b&gt;A6&lt;/b&gt; Rotación de personal (R06)&lt;br&gt;&lt;br&gt;&lt;b&gt;A7&lt;/b&gt; El cliente no autoriza cambios en su infraestructura; sobrecosto de nube (R07, R08)" vertex="1">
          <mxGeometry height="350" width="670" x="780" y="628" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=none;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" value="Elaboración propia (INT-001). [Dominio de gestión de TI]. Los IDs PUB-, PRV- e INT- remiten al registro de evidencias; R01-R08 a la matriz de riesgos del PETI. Orden de prioridad dentro de cada cuadrante. Las oportunidades sin ID son lectura del entorno hecha por el equipo." vertex="1">
          <mxGeometry height="40" width="1400" x="50" y="990" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
