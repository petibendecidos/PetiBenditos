<mxfile host="app.diagrams.net"><diagram id="porter" name="5 fuerzas de Porter"><mxGraphModel dx="1700" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;arcSize=2;fillColor=#F5F5F5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="1140" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;5 fuerzas de Porter&lt;/b&gt;&lt;br&gt;Perficient, operación en Colombia&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Servicios de ingeniería de software, datos e IA prestados desde Colombia a clientes de Norteamérica (nearshore). PETI 2026-2028&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="70" width="480" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Escala de intensidad&lt;/b&gt;&lt;br&gt;1 muy baja · 2 baja · 3 media · 4 alta · 5 muy alta&lt;br&gt;Cuánto limita cada fuerza la capacidad de sostener precios y márgenes. Tendencia esperada de octubre de 2026 a septiembre de 2028." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1150" y="70" width="480" height="100" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBF3E6;strokeColor=#F5B800;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="610" y="60" width="480" height="300" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Amenaza de nuevos entrantes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="610" y="68" width="480" height="26" as="geometry"/></mxCell><mxCell id="c7" value="Media (3/5) · estable" style="rounded=1;arcSize=50;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#F5B800;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="755.0" y="96" width="190" height="22" as="geometry"/></mxCell><mxCell id="c8" value="Barreras formales bajas: el mercado tiene «bajas barreras de entrada» [1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="622" y="128" width="222" height="98" as="geometry"/></mxCell><mxCell id="c9" value="El 11 % de los 178 proyectos de inversión extranjera de 2025 fueron de software y TI [6]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="856" y="128" width="222" height="98" as="geometry"/></mxCell><mxCell id="c10" value="Barrera real: certificaciones y niveles de socio que exige el cliente regulado (PUB-002; PUB-005 a PUB-008)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="622" y="238" width="222" height="98" as="geometry"/></mxCell><mxCell id="c11" value="Atenuante: el 92 % de los ingresos por servicios de 2023 vino de clientes recurrentes [1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="856" y="238" width="222" height="98" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF2FC;strokeColor=#3D85F0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="480" height="300" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Poder de los proveedores&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="428" width="480" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Alto (4/5) · en aumento" style="rounded=1;arcSize=50;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#3D85F0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="215.0" y="456" width="190" height="22" as="geometry"/></mxCell><mxCell id="c15" value="Talento: la contratación de colombianos por empresas extranjeras creció 49 % en 2025 [9]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="82" y="488" width="222" height="98" as="geometry"/></mxCell><mxCell id="c16" value="Salario mínimo de 2026: +23 % (Decreto 1469 de 2025) [12]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="316" y="488" width="222" height="98" as="geometry"/></mxCell><mxCell id="c17" value="Nube: Amazon, Microsoft y Google suman el 63 % del gasto mundial [10]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="82" y="598" width="222" height="98" as="geometry"/></mxCell><mxCell id="c18" value="IA: tres proveedores concentran cerca del 77 % del uso empresarial de modelos [11]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="316" y="598" width="222" height="98" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="610" y="420" width="480" height="300" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Rivalidad entre competidores&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="610" y="428" width="480" height="26" as="geometry"/></mxCell><mxCell id="c21" value="Muy alta (5/5) · en aumento" style="rounded=1;arcSize=50;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="755.0" y="456" width="190" height="22" as="geometry"/></mxCell><mxCell id="c22" value="Rivales globales: Accenture, Deloitte, EPAM, Globant, Endava, Infosys, Cognizant y Wipro [1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="622" y="488" width="222" height="98" as="geometry"/></mxCell><mxCell id="c23" value="Globant: más de 6.000 empleados en Colombia [2]. Softtek: centro en Bogotá con más de 1.000 cargos [3]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="856" y="488" width="222" height="98" as="geometry"/></mxCell><mxCell id="c24" value="Softtek obtuvo ISO/IEC 42001 en noviembre de 2025 [4]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="622" y="598" width="222" height="98" as="geometry"/></mxCell><mxCell id="c25" value="6.805 empresas de software y TI activas en Colombia [5]; precios contratados a la baja [7]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="856" y="598" width="222" height="98" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF9F4;strokeColor=#1DC97E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="480" height="300" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Poder de los compradores&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="428" width="480" height="26" as="geometry"/></mxCell><mxCell id="c28" value="Alto (4/5) · en aumento" style="rounded=1;arcSize=50;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#1DC97E;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1295.0" y="456" width="190" height="22" as="geometry"/></mxCell><mxCell id="c29" value="Cerca del 96 % de los ingresos de 2023 vino de clientes de EE. UU. [1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1162" y="488" width="222" height="98" as="geometry"/></mxCell><mxCell id="c30" value="La rebaja de precios a dos años de contrato duplica el promedio histórico [7]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1396" y="488" width="222" height="98" as="geometry"/></mxCell><mxCell id="c31" value="Exigen controles: informe SOC 2 [13]; los cambios en su infraestructura requieren su aprobación (PRV-001)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1162" y="598" width="222" height="98" as="geometry"/></mxCell><mxCell id="c32" value="Atenuante: el cliente más grande pesó cerca del 7 % de los ingresos de 2023 [1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1396" y="598" width="222" height="98" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBEDED;strokeColor=#F06B6B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="610" y="780" width="480" height="300" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Amenaza de sustitutos&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="610" y="788" width="480" height="26" as="geometry"/></mxCell><mxCell id="c35" value="Media (3/5) · en aumento" style="rounded=1;arcSize=50;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#F06B6B;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="755.0" y="816" width="190" height="22" as="geometry"/></mxCell><mxCell id="c36" value="Centros de capacidad propios (GCC): más de 6.350, con aperturas creciendo cerca del 7 % anual [8]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="622" y="848" width="222" height="98" as="geometry"/></mxCell><mxCell id="c37" value="Contratación directa de ingenieros colombianos por empresas del exterior [9]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="856" y="848" width="222" height="98" as="geometry"/></mxCell><mxCell id="c38" value="Herramientas de IA que reducen las horas que compra el cliente [7]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="622" y="958" width="222" height="98" as="geometry"/></mxCell><mxCell id="c39" value="Atenuante: montar un centro propio exige talento y conocimiento del mercado local [8]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDD835;strokeColor=none;shadow=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="856" y="958" width="222" height="98" as="geometry"/></mxCell><mxCell id="c40" value="" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.5;arrowSize=0.45;fillColor=#FFB300;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="830" y="364" width="40" height="52" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.5;arrowSize=0.45;fillColor=#3D85F0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="554" y="550" width="52" height="40" as="geometry"/></mxCell><mxCell id="c42" value="" style="shape=singleArrow;direction=west;whiteSpace=wrap;html=1;arrowWidth=0.5;arrowSize=0.45;fillColor=#10C47A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1094" y="550" width="52" height="40" as="geometry"/></mxCell><mxCell id="c43" value="" style="shape=singleArrow;direction=north;whiteSpace=wrap;html=1;arrowWidth=0.5;arrowSize=0.45;fillColor=#F07070;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="830" y="724" width="40" height="52" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Lectura para el PETI&lt;/b&gt;&lt;br&gt;La operación no puede diferenciarse por precio. Puede hacerlo por lo que demuestra ante clientes regulados: controles certificados (P1.1, P4.1), IA auditable (P1.2, P1.3) y una entrega medible (P2.3, P2.4, P2.7). Ningún factor abre un proyecto nuevo." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="800" width="480" height="140" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;[1] a [14]: fuentes del documento «Diagnóstico de las 5 fuerzas de Porter». PUB- y PRV-: registro de evidencias del proyecto. PRV-001 se cita solo como observado en la cuenta analizada. Calificaciones: valoración del equipo (INT-001)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1150" y="800" width="480" height="140" as="geometry"/></mxCell><mxCell id="c46" value="Equipo de Arquitectura y Gobernanza de TI — Perficient LATAM · octubre de 2026" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1150" y="1095" width="480" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>